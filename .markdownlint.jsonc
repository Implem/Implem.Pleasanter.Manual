// .markdownlint.jsonc
// Material for MkDocs 向け markdownlint カスタム設定
//
// 前提環境:
//   - mkdocs-material (Python-Markdown ベース)
//   - pymdownx 拡張 (Admonitions, Content Tabs, Attribute Lists 等)
//   - vscode-markdownlint (markdownlint-cli2 エンジン)
//
// 設計方針:
//   1. Material for MkDocs 固有の構文（Admonitions 等）と衝突するルールを調整する
//   2. Python-Markdown のパース挙動（特にリストのネスト）に合わせる
//   3. 自動修正可能なルールは積極的に有効化し、手動修正の負担を下げる
//   4. 明示的に false にしているルールは「意図的な無効化」であることを示す
//
// =========================================================================
// 自動修正の適用方法
// =========================================================================
//
// ── CLI（ファイル単体・プロジェクト全体） ────────────────────────────────
//
//   [インストール]
//     npm install -g markdownlint-cli2
//
//   [単一ファイルをその場修正]
//     markdownlint-cli2 --fix "docs/page.md"
//
//   [docs/ 以下の全 Markdown ファイルをその場修正]
//     markdownlint-cli2 --fix "docs/**/*.md"
//
//   [修正せずに違反のみ確認（CI 等）]
//     markdownlint-cli2 "docs/**/*.md"
//
//   注意: --fix はこのファイルと同じディレクトリまたは親ディレクトリの
//         設定ファイルを自動的に読み込む。
//         修正は上書き保存されるため、事前に Git へコミットしておくこと。
//
// ── VS Code コマンドパレット ──────────────────────────────────────────────
//
//   [開いているファイルを一括修正]
//     コマンドパレット（Ctrl+Shift+P / ⇧⌘P）を開き
//     "markdownlint: Fix all supported violations in the document" を実行
//     → 内部コマンド: markdownlint.fixAll
//
//   [ワークスペース全体をリント（違反確認のみ・修正なし）]
//     コマンドパレットを開き
//     "markdownlint: Lint all Markdown files in the workspace" を実行
//     → 内部コマンド: markdownlint.lintWorkspace
//     → 結果は「問題」パネル（Ctrl+Shift+M / ⇧⌘M）に表示される
//
// ── VS Code キーボードショートカット ─────────────────────────────────────
//
//   keybindings.json（Ctrl+Shift+P → "Open Keyboard Shortcuts (JSON)"）に
//   以下を追記することで任意のショートカットを割り当てられる。
//
//   [開いているファイルを一括修正: Ctrl+Shift+Alt+F / ⌃⇧⌥F]
//   {
//     "key": "ctrl+shift+alt+f",
//     "mac": "ctrl+shift+alt+f",
//     "command": "markdownlint.fixAll",
//     "when": "editorLangId == markdown"
//   }
//
//   [ワークスペース全体をリント: Ctrl+Shift+Alt+L / ⌃⇧⌥L]
//   {
//     "key": "ctrl+shift+alt+l",
//     "mac": "ctrl+shift+alt+l",
//     "command": "markdownlint.lintWorkspace"
//   }
//
//   when 句に "editorLangId == markdown" を付けると、
//   Markdown ファイルを開いているときのみショートカットが有効になる。
//
// ── VS Code 保存時自動修正 ────────────────────────────────────────────────
//
//   .vscode/settings.json に以下を追記すると、保存時に自動修正が走る。
//   チーム開発ではリポジトリに含めることで設定を共有できる。
//
//   "[markdown]": {
//     "editor.formatOnSave": true,          // Format Document 相当（MD系の修正）
//     "editor.codeActionsOnSave": {
//       "source.fixAll.markdownlint": true   // markdownlint.fixAll 相当
//     }
//   }
//
//   注意: formatOnSave と codeActionsOnSave を両方有効にすると修正が2回
//         走ることがある。基本的に codeActionsOnSave のみで十分。
{
  // =========================================================================
  // デフォルト設定
  // =========================================================================

  // 未記載のルールはすべてデフォルト（有効）のまま
  "default": true,

  // =========================================================================
  // 見出し（Headings）
  // =========================================================================

  // MD001: 見出しレベルは1段階ずつ増加すること → 有効（デフォルト）
  // 例: # の次が ### はNG

  // MD003: 見出しスタイルを ATX 形式（# Heading）に統一する
  // Material for MkDocs のドキュメントおよび mkdocs-material 公式サンプルは
  // すべて ATX スタイルを採用している。setext 形式（=== / ---）は使用しない。
  "MD003": { "style": "atx" },

  // MD022: 見出しの前後に空白行を置く → 有効（デフォルト）
  // Admonitions や Content Tabs のブロックとの視覚的な分離にも有効

  // MD023: 見出しは行頭から始まる → 有効（デフォルト）

  // MD024: 同一内容の見出しを禁止する
  // Material for MkDocs では変更履歴や FAQ で同じ見出しを複数使うことがある。
  // siblings_only: true にすることで、異なる親見出しの下では重複を許可する。
  "MD024": { "siblings_only": true },

  // MD025: ファイル内に H1 は1つまで → 有効（デフォルト）
  // mkdocs.yml の nav: でページタイトルを管理している場合も、
  // ドキュメント内に H1 は1つだけ置くことが Material for MkDocs の慣習。

  // MD026: 見出し末尾の句読点を禁止する
  // 日本語の「。」「、」も句読点として検出されるが、英語句読点（. ? !）のみ対象にする。
  // 日本語見出しで句点を使う場合は、ファイル内コメントで個別に無効化する。
  "MD026": { "punctuation": ".,;:!。、" },

  // MD041: ファイル先頭行を H1 見出しにする
  // Material for MkDocs では mkdocs.yml の nav: キーがページタイトルを兼ねることがある。
  // ただし明示的に H1 を置く運用が推奨されるため、有効のままにする。
  // プロジェクト全体で nav: タイトルのみ使用する場合は false に変更すること。
  "MD041": true,

  // =========================================================================
  // リスト（Lists）
  // =========================================================================

  // MD004: 箇条書きリストのマーカーをダッシュ（-）に統一する
  // Python-Markdown / Material for MkDocs の公式ドキュメントはダッシュを採用。
  // * や + との混在を防ぐ。
  "MD004": { "style": "dash" },

  // MD005: 同一レベルのリスト項目のインデントを揃える → 有効（デフォルト）

  // MD007: 箇条書きリストのインデントを 4 スペースに設定する
  // Python-Markdown のリスト継続には 4 スペースが必要。
  // CommonMark の 2 スペースとは異なるため、明示的に上書きする。
  // 参考: https://python-markdown.github.io/#differences
  "MD007": { "indent": 4 },

  // MD029: 番号付きリストのプレフィックスを 1 から順番に付ける
  // "ordered" にすると 1. 2. 3. の連番を強制する。
  // "one" にすると全項目を 1. にできる（Markdown の慣習的な書き方）。
  // Material for MkDocs では見た目上の番号はパーサーが付与するため "one" も可だが、
  // ソースの可読性のため "ordered" を推奨する。
  "MD029": { "style": "one" },

  // MD030: リストマーカーの後のスペース検証を無効化する
  "MD030": {
    "ul_single": 3,
    "ul_multi": 3,
    "ol_single": 2,
    "ol_multi": 2
  },

  // MD032: リストの前後に空白行を置く → 有効（デフォルト）
  // Admonitions ブロック内のリストにも適用される。

  // =========================================================================
  // コードブロック（Code Blocks）
  // =========================================================================

  // MD031: フェンスコードブロックの前後に空白行を置く → 有効（デフォルト）

  // MD040: フェンスコードブロックに言語指定を必須にする
  // Material for MkDocs のシンタックスハイライトは言語指定に依存する。
  // 言語が不明な場合は "text" を指定すること。
  // → デフォルトで有効のため追記不要だが、明示する
  "MD040": true,

  // MD046: コードブロックのスタイルはチェックしない
  "MD046": false,

  // MD048: コードフェンスのスタイルをバッククォートに統一する
  // チルダ（~~~）は使用しない。Material for MkDocs 公式ドキュメントはバッククォートを採用。
  "MD048": { "style": "backtick" },

  // =========================================================================
  // リンク・画像（Links / Images）
  // =========================================================================

  // MD042: 空のリンクを禁止する → 有効（デフォルト）

  // MD045: 画像 alt テキストの省略を許容する
  "MD045": false,

  // MD051: リンクフラグメントの有効性を検証する → 有効（デフォルト）
  // mkdocs-material の見出しアンカー生成規則（slugify）と一致しない場合があるため、
  // 誤検知が多い場合はコメントアウトを検討する。

  // =========================================================================
  // 空白・改行（Whitespace / Line Endings）
  // =========================================================================

  // MD009: 行末の余分なスペースを禁止する → 有効（デフォルト）
  // ただし br_spaces を 2 に設定すると、意図的な改行（2スペース）は許可される。
  // Material for MkDocs では改行には空行を使うことが推奨のため、デフォルトのまま。
  "MD009": { "br_spaces": 2, "strict": false },

  // MD010: ハードタブを禁止する → 有効（デフォルト）
  // YAML フロントマターおよびコードブロック内は除外される。

  // MD012: 連続する空白行を制限する（最大 1 行）→ 有効（デフォルト）

  // MD047: ファイルの末尾を単一の改行文字で終わらせる → 有効（デフォルト）
  // Git の diff および多くのエディターの規約に準拠。

  // =========================================================================
  // 行の長さ（Line Length）
  // =========================================================================

  // MD013: 行の長さ制限
  // 無効化する。
  "MD013": false,

  // =========================================================================
  // HTML・URL（HTML / URLs）
  // =========================================================================

  // MD033: インライン HTML の使用を制限する
  // Material for MkDocs では一部の HTML タグ（<br>、<kbd>、<div> 等）を
  // ドキュメント内で使用する場合がある。
  // allowed_elements で許可タグを明示的に列挙する。
  // プロジェクトの運用ポリシーに応じて追加・削除すること。
  "MD033": {
    "allowed_elements": [
      "br",
      "kbd",
      "sup",
      "sub",
      "abbr",
      "details",
      "summary",
      "figure",
      "figcaption",
      "div",
      "span"
    ]
  },

  // MD034: 裸の URL を禁止する（<URL> 形式か [text](URL) 形式を使う）→ 有効（デフォルト）

  // =========================================================================
  // テーブル（Tables）
  // =========================================================================

  // MD055: テーブルのパイプスタイルを統一する（leading_and_trailing: 両端にパイプを置く）
  // Material for MkDocs のドキュメントは両端パイプを採用。
  "MD055": { "style": "leading_and_trailing" },

  // MD056: テーブルの列数を揃える → 有効（デフォルト）

  // MD058: テーブルの前後に空白行を置く → 有効（デフォルト）

  // =========================================================================
  // 強調（Emphasis）
  // =========================================================================

  // MD049: 斜体（em）スタイルをアスタリスク（*）に統一する
  "MD049": { "style": "asterisk" },

  // MD050: 太字（strong）スタイルをアスタリスク（**）に統一する
  "MD050": { "style": "asterisk" },

  // =========================================================================
  // 水平線（Horizontal Rules）
  // =========================================================================

  // MD035: 水平線のスタイルを --- に統一する
  // YAML フロントマターの区切り（---）との混同を避けるため、
  // 水平線を使う場合は前後に空白行を置くこと（MD022 が補完する）。
  "MD035": { "style": "---" },

  // =========================================================================
  // ブロッククォート（Blockquotes）
  // =========================================================================

  // MD027: ブロッククォート記号（>）の後のスペースを1つに統一する → 有効（デフォルト）
  // MD028: ブロッククォート内の空白行を禁止する → 有効（デフォルト）

  // =========================================================================
  // 固有名詞（Proper Names）
  // =========================================================================

  // MD044: 固有名詞の大文字表記を強制する → いったん無効化する
  //
  // 無効化の理由:
  //   --fix（VS Code の fixAll・保存時修正を含む）を走らせると、
  //   本文中の小文字が正しい語まで書き換わる。
  //
  //     /var/lib/pgsql/18/data/postgresql.conf  →  .../PostgreSQL.conf
  //     /etc/mysql/mysql.conf.d/mysqld.cnf      →  /etc/MySQL/...
  //     MYSQL_ROOT_PASSWORD                     →  MySQL_ROOT_PASSWORD
  //
  //   Linux はパスの大小文字を区別するため、存在しないファイルを開く手順になる。
  //   code_blocks: false でコードブロックとインラインコードは対象外だが、
  //   本文に素で書かれたパス・コマンド・環境変数は守られない。
  //   全 docs で 198 件の指摘のうち約 130 件（27 ファイル）がこの型だった。
  //
  // 再び有効にする場合は、先にパス・コマンド・環境変数をインラインコード（`...`）へ
  //   直してから names を戻すこと。
  "MD044": false
}
